# Copy to .env and provide an Atlas API key with access only to disposable test resources.
ATLAS_RUN_INTEGRATION=false
ATLAS_PUBLIC_KEY=
ATLAS_PRIVATE_KEY=
ATLAS_PROJECT_ID=
ATLAS_BASE_URL=https://cloud.mongodb.com/api/atlas/v2
ATLAS_API_VERSION=2025-03-12

# Read-only resource identifiers
ATLAS_TEST_CLUSTER_NAME=
ATLAS_TEST_ALERT_ID=
ATLAS_TEST_EVENT_ID=
ATLAS_TEST_ORG_ID=
ATLAS_TEST_PROJECT_NAME=
ATLAS_TEST_SNAPSHOT_ID=
ATLAS_TEST_RESTORE_JOB_ID=

# Opt-in CRUD flags and prerequisites
ATLAS_RUN_ACCESS_LIST_CRUD=false
ATLAS_ACCESS_LIST_CREATE_BODY={}
ATLAS_RUN_DATABASE_USER_CRUD=false
ATLAS_DATABASE_USER_CREATE_BODY={}
ATLAS_DATABASE_USER_UPDATE_BODY={}
ATLAS_RUN_CUSTOM_ROLE_CRUD=false
ATLAS_CUSTOM_ROLE_CREATE_BODY={}
ATLAS_CUSTOM_ROLE_UPDATE_BODY={}
ATLAS_RUN_PROJECT_CRUD=false
ATLAS_PROJECT_ORG_ID=
ATLAS_RUN_SEARCH_INDEX_CRUD=false
ATLAS_SEARCH_DATABASE=
ATLAS_SEARCH_COLLECTION=
ATLAS_SEARCH_CREATE_BODY={}
ATLAS_SEARCH_UPDATE_BODY={}

# Provide only when testing cloud-provider access. The created role is deleted during cleanup.
ATLAS_RUN_CLOUD_PROVIDER_ACCESS_CRUD=false
ATLAS_CLOUD_PROVIDER_ACCESS_CREATE_BODY={}
ATLAS_CLOUD_PROVIDER_ACCESS_UPDATE_BODY={}
ATLAS_CLOUD_PROVIDER=

# Cluster and backup mutation tests are intentionally not automated because they can incur cost or lack a reliable cleanup operation in this client.
